{
  "name": "readylink-server",
  "version": "0.1.0",
  "private": true,
  "description": "READYLINK backend (Node.js + Express). Phase 2: the frontend now uses the reports API. SQLite database, photo uploads, serves the frontend.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "db:list": "node src/scripts/listReports.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.0.0"
  }
}
