# READYLINK server settings.
# Copy this file to ".env" (Windows: copy .env.example .env) and edit the copy.
# NEVER commit ".env". It is listed in .gitignore. Never put secrets in frontend files.

# Port the server listens on (0 to 65535).
PORT=3000

# 127.0.0.1 = reachable only from this computer (recommended for development).
# Do not use 0.0.0.0 unless you deliberately want other devices on your network to connect.
HOST=127.0.0.1

# development | test | production
NODE_ENV=development

# Optional. Absolute path of the frontend folder.
# Default is the repository root, which already contains index.html, css/, js/ and data/.
# FRONTEND_DIR=

# --- Database and uploads (Phase 1) ---------------------------------------------------------
# auto = use better-sqlite3 if it installed correctly, otherwise the SQLite built into Node.js (node:sqlite).
# Other values: better-sqlite3 | node-sqlite
DB_DRIVER=auto

# Database file. A relative path is relative to the "server" folder. Never commit it (it is in .gitignore).
DB_FILE=data/readylink.db

# Folder for uploaded photos. A relative path is relative to the "server" folder. Never commit it.
UPLOADS_DIR=uploads

# Largest accepted photo in bytes (5 MB = 5242880). Allowed range: 1024 to 20971520.
MAX_PHOTO_BYTES=5242880
